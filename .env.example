# AI chat backend — copy this file to `.env` and fill in YOUR keys.
# Never commit `.env`. These keys only ever live on the server, never in the browser.

# Which provider to use: "deepseek" (default) | "google" | "nvidia"
LLM_PROVIDER=deepseek

# NVIDIA (Gemma via build.nvidia.com) — key from the NVIDIA API Catalog
NVIDIA_API_KEY=
NVIDIA_MODEL=google/gemma-4-31b-it

# DeepSeek — get a key at https://platform.deepseek.com (Settings -> API Keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Google AI (Gemini or Gemma) — get a key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# Lead capture (Contact form + AI assistant) -> Google Sheet.
# Paste the Apps Script webhook URL from scripts/gsheets-leads.gs after deploying.
# Must also be set in Vercel: Project Settings -> Environment Variables.
VITE_LEAD_WEBHOOK_URL=

# Realistic voice replies. Pick one provider via TTS_PROVIDER.
#
# Gemini (RECOMMENDED — hosted, realistic, works on Vercel) — uses the same
# GOOGLE_AI_API_KEY as the chatbot. No extra keys needed.
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# LIVE VOICE (phone-call style, ChatGPT-like real-time conversation).
# Uses the Gemini Live API — ephemeral tokens are minted server-side via
# /api/live-token so your GOOGLE_AI_API_KEY never reaches the browser.
# Requires the same GOOGLE_AI_API_KEY above.
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Kore

# Voicebox (local-first, free, no keys) — the LLM/chatbot voices you wanted.
# Requires the Voicebox app running on a machine the server can reach:
#   - local dev: run Voicebox on this PC (default http://localhost:17493)
#   - production: point VOICEBOX_URL at a tunnel (cloudflared/ngrok) or a
#     Remote Mode GPU server exposing port 17493.
# TTS_PROVIDER=voicebox
# VOICEBOX_URL=http://localhost:17493
# VOICEBOX_PROFILE_ID=default
# VOICEBOX_ENGINE=kokoro
# VOICEBOX_LANGUAGE=en

# ElevenLabs (free tier ~10k credits/mo, no card): create a key at elevenlabs.io
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI TTS (needs billing on the OpenAI account):
# OPENAI_API_KEY=
# OPENAI_TTS_VOICE=nova